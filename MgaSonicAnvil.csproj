<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>MgaSonicAnvil.Program</StartupObject>
    <RootNamespace>MgaSonicAnvil</RootNamespace>
    <AssemblyName>MGA Sonic Anvil</AssemblyName>
    <Product>MGA Sonic Anvil</Product>
    <ApplicationTitle>MGA Sonic Anvil</ApplicationTitle>
    <Company>MIYABI GAME AUDIO INC.</Company>
    <Authors>MIYABI GAME AUDIO INC.</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/mga-ueda/MGA-Sonic-Anvil</RepositoryUrl>
    <PackageProjectUrl>https://github.com/mga-ueda/MGA-Sonic-Anvil</PackageProjectUrl>
    <ApplicationIcon>Assets\Branding\MgaSonicAnvil.ico</ApplicationIcon>
    <Version>0.0.1-beta</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Utf8Output>true</Utf8Output>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)publish\</PublishDir>
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);MgaSonicAnvil.Tests\**;tools\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MgaSonicAnvil.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="UI\ColorDevPanelWindow.xaml.cs" />
    <Page Remove="UI\ColorDevPanelWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppVersion</_Parameter1>
      <_Parameter2>$(Version)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Branding\MgaSonicAnvil.ico">
      <LogicalName>MgaSonicAnvil.Branding.MgaSonicAnvil.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Branding\MgaSonicAnvil.ico" />
  </ItemGroup>

</Project>
