<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>MgaSonicAnvil.Program</StartupObject>
    <RootNamespace>MgaSonicAnvil</RootNamespace>
    <AssemblyName>MGA Sonic Anvil</AssemblyName>
    <Product>MGA Sonic Anvil</Product>
    <ApplicationTitle>MGA Sonic Anvil</ApplicationTitle>
    <Company>MIYABI GAME AUDIO INC.</Company>
    <Authors>MIYABI GAME AUDIO INC.</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/mga-ueda/MGA-Sonic-Anvil</RepositoryUrl>
    <PackageProjectUrl>https://github.com/mga-ueda/MGA-Sonic-Anvil</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>Assets\Branding\MgaSonicAnvil.ico</ApplicationIcon>
    <Version>1.2.7-beta</Version>
    <AssemblyVersion>1.2.7.0</AssemblyVersion>
    <FileVersion>1.2.7.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Utf8Output>true</Utf8Output>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)publish\</PublishDir>
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);testdata\**;tools\**;native\**;artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MgaSonicAnvil.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppVersion</_Parameter1>
      <_Parameter2>$(Version)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Branding\MgaSonicAnvil.ico">
      <LogicalName>MgaSonicAnvil.Branding.MgaSonicAnvil.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Click\Low.wav">
      <LogicalName>MgaSonicAnvil.Assets.Click.Low.wav</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Click\High.wav">
      <LogicalName>MgaSonicAnvil.Assets.Click.High.wav</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Branding\MgaSonicAnvil.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="native\SignalsmithStretch\win-x64\SignalsmithStretch.dll" Condition="Exists('native\SignalsmithStretch\win-x64\SignalsmithStretch.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>SignalsmithStretch.dll</Link>
      <Visible>false</Visible>
    </None>
    <None Include="native\effetune-rhythm\win-x64\EffeTuneRhythm.dll" Condition="Exists('native\effetune-rhythm\win-x64\EffeTuneRhythm.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>EffeTuneRhythm.dll</Link>
      <Visible>false</Visible>
    </None>
    <None Include="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>THIRD_PARTY_NOTICES.md</Link>
      <Visible>false</Visible>
    </None>
    <None Include="native\effetune-rhythm\LICENSE-EffeTune.txt" Condition="Exists('native\effetune-rhythm\LICENSE-EffeTune.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>LICENSE-EffeTune.txt</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
