<UserControl x:Class="MgaSonicAnvil.UI.TransportBar"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MgaSonicAnvil.UI"
             Height="{x:Static ui:DesignMetrics.TransportBarHeight}"
             Focusable="False"
             Background="{DynamicResource TransportBackBrush}">
  <Grid Margin="12,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TextBlock x:Name="PositionText"
               Width="{x:Static ui:DesignMetrics.TransportPositionWidth}"
               VerticalAlignment="Center"
               FontFamily="Consolas"
               FontWeight="Bold"
               FontSize="16"
               Foreground="{DynamicResource PrimaryForeBrush}"
               ToolTip="再生ヘッド位置"
               Text="00:00.000" />
    <StackPanel x:Name="ButtonsHost"
                Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
  </Grid>
</UserControl>
