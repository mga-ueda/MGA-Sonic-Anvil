<Window x:Class="MgaSonicAnvil.UI.AudioSettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MgaSonicAnvil.UI"
        xmlns:domain="clr-namespace:MgaSonicAnvil.Domain"
        WindowStyle="SingleBorderWindow"
        SizeToContent="Manual"
        ResizeMode="CanResize"
        Width="{x:Static ui:DesignMetrics.SettingsWindowMinWidth}"
        MinWidth="{x:Static ui:DesignMetrics.SettingsWindowMinWidth}"
        Height="{x:Static ui:DesignMetrics.SettingsWindowHeight}"
        MinHeight="{x:Static ui:DesignMetrics.SettingsWindowMinHeight}"
        MaxHeight="{x:Static ui:DesignMetrics.SettingsWindowMaxHeight}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackBrush}"
        Foreground="{DynamicResource PrimaryForeBrush}"
        Title="{x:Static domain:UiStrings.DialogSettingsTitle}"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown">
  <Border Padding="{x:Static ui:DesignMetrics.AudioPad}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TabControl x:Name="SettingsTabs"
                  SelectionChanged="SettingsTabs_SelectionChanged">
        <TabItem Header="{x:Static domain:UiStrings.LabelSettingsTabGeneral}">
          <StackPanel MaxWidth="{x:Static ui:DesignMetrics.SettingsPanelWidth}"
                      HorizontalAlignment="Left">
            <Grid HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LanguageLabel"
                         Text="{x:Static domain:UiStrings.LabelUiLanguage}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <ComboBox x:Name="LanguageCombo"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                        Padding="6,1"
                        FontSize="11.333"
                        VerticalContentAlignment="Center" />
            </Grid>

            <TextBlock x:Name="AssociationHeader"
                       Text="{x:Static domain:UiStrings.LabelFileAssociations}"
                       FontWeight="Bold"
                       FontSize="11.333"
                       Margin="0,16,0,6" />
            <StackPanel x:Name="AssociationHost" />
          </StackPanel>
        </TabItem>

        <TabItem x:Name="LayoutsTab" Header="{x:Static domain:UiStrings.LabelSettingsTabLayouts}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="SpeakerVisibilityHeader"
                       Text="{x:Static domain:UiStrings.LabelSpeakerVisibility}"
                       FontWeight="Bold"
                       FontSize="11.333"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="SpeakerVisibilityHost" />
            </ScrollViewer>
          </Grid>
        </TabItem>

        <TabItem x:Name="AudioTab" Header="{x:Static domain:UiStrings.LabelSettingsTabAudio}">
          <Grid x:Name="AudioTabBody">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SpeakerLabel"
                           Text="{x:Static domain:UiStrings.LabelSpeaker}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox x:Name="SpeakerCombo"
                          Grid.Column="1"
                          HorizontalAlignment="Left"
                          Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                          Padding="6,1"
                          FontSize="11.333"
                          VerticalContentAlignment="Center"
                          SelectionChanged="SpeakerCombo_SelectionChanged" />
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ApiLabel"
                           Text="{x:Static domain:UiStrings.LabelAudioApi}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox x:Name="ApiCombo"
                          Grid.Column="1"
                          HorizontalAlignment="Left"
                          Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                          Padding="6,1"
                          FontSize="11.333"
                          VerticalContentAlignment="Center"
                          SelectionChanged="ApiCombo_SelectionChanged" />
                <TextBlock x:Name="DeviceLabel"
                           Grid.Column="2"
                           Text="{x:Static domain:UiStrings.LabelAudioDevice}"
                           VerticalAlignment="Center"
                           Margin="16,0,8,0" />
                <ComboBox x:Name="DeviceCombo"
                          Grid.Column="3"
                          HorizontalAlignment="Left"
                          Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                          Padding="6,1"
                          FontSize="11.333"
                          VerticalContentAlignment="Center"
                          SelectionChanged="DeviceCombo_SelectionChanged" />
              </Grid>
            </StackPanel>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{x:Static ui:DesignMetrics.SettingsColumnGapGrid}" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ScrollViewer Style="{StaticResource SettingsColumnScrollViewerStyle}">
                <StackPanel>
                  <TextBlock x:Name="InputHeader"
                             Text="{x:Static domain:UiStrings.LabelSettingsInput}"
                             FontWeight="Bold"
                             FontSize="11.333"
                             Margin="0,0,0,6" />

                  <StackPanel x:Name="RecordInputHost" Margin="0,0,0,6" />
                  <TextBlock x:Name="InputStatus"
                             FontSize="11"
                             Foreground="{DynamicResource MutedForeBrush}"
                             TextWrapping="Wrap"
                             Visibility="Collapsed" />
                </StackPanel>
              </ScrollViewer>

              <ScrollViewer Grid.Column="2"
                            Style="{StaticResource SettingsColumnScrollViewerStyle}">
                <StackPanel>
                  <TextBlock x:Name="OutputHeader"
                             Text="{x:Static domain:UiStrings.LabelSettingsOutput}"
                             FontWeight="Bold"
                             FontSize="11.333"
                             Margin="0,0,0,6" />

                  <StackPanel x:Name="PlaybackOutputHost" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="{x:Static domain:UiStrings.LabelSettingsTabEditing}">
          <StackPanel MaxWidth="{x:Static ui:DesignMetrics.SettingsPanelWidth}"
                      HorizontalAlignment="Left">
            <TextBlock x:Name="LoudnessTargetLabel"
                       Text="{x:Static domain:UiStrings.LabelLoudnessTarget}"
                       Margin="0,0,0,3" />
            <Grid HorizontalAlignment="Left" Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="LoudnessTargetBox"
                       Width="{x:Static ui:DesignMetrics.SettingsLoudnessBoxWidth}"
                       Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                       Style="{StaticResource DarkTextBoxStyle}"
                       Padding="6,1"
                       FontSize="11.333"
                       VerticalContentAlignment="Center" />
              <TextBlock x:Name="LoudnessTargetUnit"
                         Grid.Column="1"
                         Text="{x:Static domain:UiStrings.LabelLufs}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0" />
            </Grid>

            <TextBlock x:Name="FadeDefaultsHeader"
                       Text="{x:Static domain:UiStrings.LabelFadeCurveDefaults}"
                       FontWeight="Bold"
                       FontSize="11.333"
                       Margin="0,4,0,6" />
            <StackPanel x:Name="FadeRowsHost" />
          </StackPanel>
        </TabItem>

        <TabItem Header="{x:Static domain:UiStrings.LabelSettingsTabExport}">
          <StackPanel MaxWidth="{x:Static ui:DesignMetrics.SettingsPanelWidth}"
                      HorizontalAlignment="Left">
            <TextBlock x:Name="Mp3Header"
                       Text="{x:Static domain:UiStrings.LabelMp3Encode}"
                       FontWeight="Bold"
                       FontSize="11.333"
                       Margin="0,0,0,6" />

            <Grid HorizontalAlignment="Left" Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="WindowsBitRateLabel"
                         Text="{x:Static domain:UiStrings.LabelWindowsMp3BitRate}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <ComboBox x:Name="WindowsBitRateCombo"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                        Padding="6,1"
                        FontSize="11.333"
                        VerticalContentAlignment="Center" />
            </Grid>

            <TextBlock x:Name="LamePathLabel"
                       Text="{x:Static domain:UiStrings.LabelLamePath}"
                       Margin="0,0,0,3" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="LamePathBox"
                       Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                       Style="{StaticResource DarkTextBoxStyle}"
                       Padding="6,1"
                       FontSize="11.333"
                       VerticalContentAlignment="Center" />
              <ui:RoundedButton x:Name="LameBrowseButton"
                                Grid.Column="1"
                                Content="{x:Static domain:UiStrings.ButtonBrowse}"
                                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                MinWidth="64"
                                Margin="8,0,0,0"
                                Click="LameBrowseButton_Click" />
            </Grid>

            <TextBlock x:Name="LameOptionsLabel"
                       Text="{x:Static domain:UiStrings.LabelLameOptions}"
                       Margin="0,0,0,3" />
            <TextBox x:Name="LameOptionsBox"
                     Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Padding="6,1"
                     FontSize="11.333"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,16" />

            <Grid HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ExportParallelLabel"
                         Text="{x:Static domain:UiStrings.LabelExportParallel}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <ComboBox x:Name="ExportParallelCombo"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                        Padding="6,1"
                        FontSize="11.333"
                        VerticalContentAlignment="Center"
                        SelectionChanged="ExportParallelCombo_SelectionChanged" />
            </Grid>
          </StackPanel>
        </TabItem>
      </TabControl>

      <StackPanel Grid.Row="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,16,0,0">
        <ui:RoundedButton x:Name="OkButton"
                          Content="{x:Static domain:UiStrings.ButtonOk}"
                          Width="{x:Static ui:DesignMetrics.AudioDialogButtonWidth}"
                          Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                          Margin="0,0,12,0"
                          IsDefault="True"
                          Click="OkButton_Click" />
        <ui:RoundedButton x:Name="CancelButton"
                          Content="{x:Static domain:UiStrings.ButtonCancel}"
                          Width="{x:Static ui:DesignMetrics.AudioDialogButtonWidth}"
                          Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                          IsCancel="True"
                          Click="CancelButton_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
