<Window x:Class="MgaSonicAnvil.UI.AudioSettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MgaSonicAnvil.UI"
        xmlns:domain="clr-namespace:MgaSonicAnvil.Domain"
        WindowStyle="SingleBorderWindow"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackBrush}"
        Foreground="{DynamicResource PrimaryForeBrush}"
        Title="{x:Static domain:UiStrings.DialogSettingsTitle}"
        KeyDown="Window_KeyDown">
  <Border Padding="{x:Static ui:DesignMetrics.AudioPad}">
    <StackPanel x:Name="ContentRoot" Width="420">
      <TextBlock x:Name="LanguageLabel"
                 Text="{x:Static domain:UiStrings.LabelUiLanguage}"
                 Margin="0,0,0,3" />
      <ComboBox x:Name="LanguageCombo"
                Width="{x:Static ui:DesignMetrics.SettingsShortComboWidth}"
                HorizontalAlignment="Left"
                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                Padding="6,1"
                FontSize="11.333"
                VerticalContentAlignment="Center"
                Margin="0,0,0,12" />

      <TextBlock x:Name="ApiLabel"
                 Text="{x:Static domain:UiStrings.LabelAudioApi}"
                 Margin="0,0,0,3" />
      <ComboBox x:Name="ApiCombo"
                Width="{x:Static ui:DesignMetrics.SettingsShortComboWidth}"
                HorizontalAlignment="Left"
                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                Padding="6,1"
                FontSize="11.333"
                VerticalContentAlignment="Center"
                Margin="0,0,0,12"
                SelectionChanged="ApiCombo_SelectionChanged" />

      <TextBlock x:Name="DeviceLabel"
                 Text="{x:Static domain:UiStrings.LabelAudioDevice}"
                 Margin="0,0,0,3" />
      <ComboBox x:Name="DeviceCombo"
                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                Padding="6,1"
                FontSize="11.333"
                VerticalContentAlignment="Center"
                Margin="0,0,0,12" />

      <TextBlock x:Name="LoudnessTargetLabel"
                 Text="{x:Static domain:UiStrings.LabelLoudnessTarget}"
                 Margin="0,0,0,3" />
      <Grid HorizontalAlignment="Left" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="LoudnessTargetBox"
                 Width="{x:Static ui:DesignMetrics.SettingsLoudnessBoxWidth}"
                 Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                 Style="{StaticResource DarkTextBoxStyle}"
                 Padding="6,1"
                 FontSize="11.333"
                 VerticalContentAlignment="Center" />
        <TextBlock x:Name="LoudnessTargetUnit"
                   Grid.Column="1"
                   Text="{x:Static domain:UiStrings.LabelLufs}"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0" />
      </Grid>

      <TextBlock x:Name="FadeDefaultsHeader"
                 Text="{x:Static domain:UiStrings.LabelFadeCurveDefaults}"
                 FontWeight="Bold"
                 FontSize="11.333"
                 Margin="0,4,0,6" />

      <StackPanel x:Name="FadeRowsHost"
                  Margin="0,0,0,12" />

      <TextBlock x:Name="Mp3Header"
                 Text="{x:Static domain:UiStrings.LabelMp3Encode}"
                 FontWeight="Bold"
                 FontSize="11.333"
                 Margin="0,4,0,6" />

      <TextBlock x:Name="WindowsBitRateLabel"
                 Text="{x:Static domain:UiStrings.LabelWindowsMp3BitRate}"
                 Margin="0,0,0,3" />
      <ComboBox x:Name="WindowsBitRateCombo"
                Width="{x:Static ui:DesignMetrics.SettingsBitRateComboWidth}"
                HorizontalAlignment="Left"
                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                Padding="6,1"
                FontSize="11.333"
                VerticalContentAlignment="Center"
                Margin="0,0,0,12" />

      <TextBlock x:Name="LamePathLabel"
                 Text="{x:Static domain:UiStrings.LabelLamePath}"
                 Margin="0,0,0,3" />
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="LamePathBox"
                 Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                 Style="{StaticResource DarkTextBoxStyle}"
                 Padding="6,1"
                 FontSize="11.333"
                 VerticalContentAlignment="Center" />
        <ui:RoundedButton x:Name="LameBrowseButton"
                          Grid.Column="1"
                          Content="{x:Static domain:UiStrings.ButtonBrowse}"
                          Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                          MinWidth="64"
                          Margin="8,0,0,0"
                          Click="LameBrowseButton_Click" />
      </Grid>

      <TextBlock x:Name="LameOptionsLabel"
                 Text="{x:Static domain:UiStrings.LabelLameOptions}"
                 Margin="0,0,0,3" />
      <TextBox x:Name="LameOptionsBox"
               Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
               Style="{StaticResource DarkTextBoxStyle}"
               Padding="6,1"
               FontSize="11.333"
               VerticalContentAlignment="Center"
               Margin="0,0,0,12" />

      <TextBlock x:Name="ExportParallelLabel"
                 Text="{x:Static domain:UiStrings.LabelExportParallel}"
                 Margin="0,0,0,3" />
      <ComboBox x:Name="ExportParallelCombo"
                Width="{x:Static ui:DesignMetrics.SettingsShortComboWidth}"
                HorizontalAlignment="Left"
                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                Padding="6,1"
                FontSize="11.333"
                VerticalContentAlignment="Center"
                Margin="0,0,0,16" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:RoundedButton x:Name="OkButton"
                          Content="{x:Static domain:UiStrings.ButtonOk}"
                          Width="{x:Static ui:DesignMetrics.AudioDialogButtonWidth}"
                          Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                          Margin="0,0,12,0"
                          IsDefault="True"
                          Click="OkButton_Click" />
        <ui:RoundedButton x:Name="CancelButton"
                          Content="{x:Static domain:UiStrings.ButtonCancel}"
                          Width="{x:Static ui:DesignMetrics.AudioDialogButtonWidth}"
                          Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                          IsCancel="True"
                          Click="CancelButton_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
