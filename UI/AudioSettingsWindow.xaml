<Window x:Class="MgaSonicAnvil.UI.AudioSettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MgaSonicAnvil.UI"
        xmlns:domain="clr-namespace:MgaSonicAnvil.Domain"
        WindowStyle="SingleBorderWindow"
        SizeToContent="Manual"
        ResizeMode="CanResizeWithGrip"
        Width="{x:Static ui:DesignMetrics.SettingsWindowMinWidth}"
        MinWidth="{x:Static ui:DesignMetrics.SettingsWindowMinWidth}"
        Height="{x:Static ui:DesignMetrics.SettingsWindowHeight}"
        MinHeight="{x:Static ui:DesignMetrics.SettingsWindowMinHeight}"
        MaxHeight="{x:Static ui:DesignMetrics.SettingsWindowMaxHeight}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackBrush}"
        Foreground="{DynamicResource PrimaryForeBrush}"
        Title="{x:Static domain:UiStrings.DialogSettingsTitle}"
        KeyboardNavigation.TabNavigation="Cycle"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Border Padding="{x:Static ui:DesignMetrics.AudioPad}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TabControl x:Name="SettingsTabs"
                  SelectionChanged="SettingsTabs_SelectionChanged">
        <TabItem Header="{x:Static domain:UiStrings.LabelSettingsTabGeneral}">
          <StackPanel MaxWidth="{x:Static ui:DesignMetrics.SettingsPanelWidth}"
                      HorizontalAlignment="Left">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="120" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="LanguageLabel"
                         Text="{x:Static domain:UiStrings.LabelUiLanguage}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <ComboBox x:Name="LanguageCombo"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                        Padding="6,1"
                        FontSize="11.333"
                        VerticalContentAlignment="Center" />
              <TextBlock x:Name="UiScaleLabel"
                         Grid.Row="1"
                         Text="{x:Static domain:UiStrings.LabelUiScale}"
                         VerticalAlignment="Center"
                         Margin="0,8,8,0" />
              <ComboBox x:Name="UiScaleCombo"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                        Margin="0,8,0,0"
                        Padding="6,1"
                        FontSize="11.333"
                        VerticalContentAlignment="Center" />
              <TextBlock x:Name="MultiFileArrangeLabel"
                         Grid.Row="2"
                         Text="{x:Static domain:UiStrings.LabelMultiFileArrange}"
                         VerticalAlignment="Center"
                         Margin="0,8,8,0" />
              <ComboBox x:Name="MultiFileArrangeCombo"
                        Grid.Row="2"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                        Margin="0,8,0,0"
                        Padding="6,1"
                        FontSize="11.333"
                        VerticalContentAlignment="Center" />
              <TextBlock x:Name="LaunchModeLabel"
                         Grid.Row="3"
                         Text="{x:Static domain:UiStrings.LabelAppLaunchMode}"
                         VerticalAlignment="Center"
                         Margin="0,8,8,0" />
              <ComboBox x:Name="LaunchModeCombo"
                        Grid.Row="3"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                        Margin="0,8,0,0"
                        Padding="6,1"
                        FontSize="11.333"
                        VerticalContentAlignment="Center" />
              <TextBlock x:Name="LaunchModeHint"
                         Grid.Row="3"
                         Grid.Column="2"
                         Text="{x:Static domain:UiStrings.LabelAppLaunchModeHint}"
                         FontSize="11.333"
                         Foreground="{DynamicResource MutedForeBrush}"
                         VerticalAlignment="Center"
                         Margin="8,8,0,0" />
              <TextBlock x:Name="ExportParallelLabel"
                         Grid.Row="4"
                         Text="{x:Static domain:UiStrings.LabelExportParallel}"
                         VerticalAlignment="Center"
                         Margin="0,8,8,0" />
              <Grid Grid.Row="4"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ExportParallelCombo"
                          HorizontalAlignment="Left"
                          Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                          Padding="6,1"
                          FontSize="11.333"
                          VerticalContentAlignment="Center"
                          SelectionChanged="ExportParallelCombo_SelectionChanged" />
                <TextBlock x:Name="ExportParallelHint"
                           Grid.Column="1"
                           Text="{x:Static domain:UiStrings.LabelExportParallelHint}"
                           FontSize="11.333"
                           Foreground="{DynamicResource MutedForeBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="8,0,0,0" />
              </Grid>
            </Grid>

            <TextBlock Text="{x:Static domain:UiStrings.LabelWallpaper}"
                       FontWeight="Bold"
                       FontSize="11.333"
                       Margin="0,16,0,6" />
            <TextBlock Text="{x:Static domain:UiStrings.LabelWallpaperPath}"
                       Margin="0,0,0,3" />
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:StretchSlot>
                <TextBox x:Name="WallpaperPathBox"
                         Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Padding="6,1"
                         FontSize="11.333"
                         VerticalContentAlignment="Center" />
              </ui:StretchSlot>
              <ui:RoundedButton x:Name="WallpaperBrowseButton"
                                Grid.Column="1"
                                Content="{x:Static domain:UiStrings.ButtonBrowse}"
                                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                MinWidth="64"
                                Margin="8,0,0,0"
                                Click="WallpaperBrowseButton_Click" />
              <ui:RoundedButton x:Name="WallpaperClearButton"
                                Grid.Column="2"
                                Content="{x:Static domain:UiStrings.ButtonWallpaperClear}"
                                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                MinWidth="64"
                                Margin="8,0,0,0"
                                Click="WallpaperClearButton_Click" />
            </Grid>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static domain:UiStrings.LabelWallpaperOpacity}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <TextBox x:Name="WallpaperOpacityBox"
                       Grid.Column="1"
                       Width="56"
                       Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                       Style="{StaticResource DarkTextBoxStyle}"
                       Padding="6,1"
                       FontSize="11.333"
                       TextAlignment="Center"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Center" />
              <TextBlock Grid.Column="2"
                         Text="%"
                         VerticalAlignment="Center"
                         Margin="6,0,0,0" />
            </Grid>
            <TextBlock Text="{x:Static domain:UiStrings.LabelWallpaperHint}"
                       FontSize="11.333"
                       Foreground="{DynamicResource MutedForeBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4" />

            <TextBlock x:Name="AssociationHeader"
                       Text="{x:Static domain:UiStrings.LabelFileAssociations}"
                       FontWeight="Bold"
                       FontSize="11.333"
                       Margin="0,16,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <ui:RoundedButton x:Name="AssociationAllOnButton"
                                Content="{x:Static domain:UiStrings.ButtonFileAssociationsAllOn}"
                                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                MinWidth="72"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                Click="AssociationAllOnButton_Click" />
              <ui:RoundedButton x:Name="AssociationAllOffButton"
                                Content="{x:Static domain:UiStrings.ButtonFileAssociationsAllOff}"
                                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                MinWidth="72"
                                Padding="12,0"
                                Click="AssociationAllOffButton_Click" />
            </StackPanel>
            <Grid x:Name="AssociationHost">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="140" />
                <ColumnDefinition Width="{x:Static ui:DesignMetrics.SettingsColumnGapGrid}" />
                <ColumnDefinition Width="*" MinWidth="140" />
              </Grid.ColumnDefinitions>
            </Grid>
          </StackPanel>
        </TabItem>

        <TabItem x:Name="LayoutsTab" Header="{x:Static domain:UiStrings.LabelSettingsTabLayouts}">
          <Grid x:Name="LayoutsTabBody">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="120" />
              <ColumnDefinition Width="{x:Static ui:DesignMetrics.SettingsColumnGapGrid}" />
              <ColumnDefinition Width="2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Style="{StaticResource SettingsColumnScrollViewerStyle}">
              <StackPanel>
                <TextBlock x:Name="SpeakerVisibilityHeader"
                           Text="{x:Static domain:UiStrings.LabelSpeakerVisibility}"
                           FontWeight="Bold"
                           FontSize="11.333"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap" />
                <StackPanel x:Name="SpeakerVisibilityHost" />
              </StackPanel>
            </ScrollViewer>

            <Grid x:Name="LayoutsPlaylistPane" Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
              </Grid.RowDefinitions>

              <StackPanel Margin="0,0,0,12">
                <TextBlock x:Name="LibraryPlaylistDocumentsHeader"
                           Text="{x:Static domain:UiStrings.LabelLibraryPlaylistDocuments}"
                           FontWeight="Bold"
                           FontSize="11.333"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap" />
                <CheckBox x:Name="LibraryShowPlaylistPdfBox"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          Content="{x:Static domain:UiStrings.LabelLibraryShowPlaylistPdf}"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,6"
                          VerticalContentAlignment="Center" />
                <CheckBox x:Name="LibraryShowPlaylistMovBox"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          Content="{x:Static domain:UiStrings.LabelLibraryShowPlaylistMov}"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,6"
                          VerticalContentAlignment="Center" />
                <CheckBox x:Name="LibraryShowPlaylistMp4Box"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          Content="{x:Static domain:UiStrings.LabelLibraryShowPlaylistMp4}"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,6"
                          VerticalContentAlignment="Center" />
                <CheckBox x:Name="LibraryShowPlaylistAviBox"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          Content="{x:Static domain:UiStrings.LabelLibraryShowPlaylistAvi}"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,6"
                          VerticalContentAlignment="Center" />
                <CheckBox x:Name="LibraryShowPlaylistMkvBox"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          Content="{x:Static domain:UiStrings.LabelLibraryShowPlaylistMkv}"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,6"
                          VerticalContentAlignment="Center" />
                <CheckBox x:Name="LibraryShowPlaylistWebmBox"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          Content="{x:Static domain:UiStrings.LabelLibraryShowPlaylistWebm}"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,6"
                          VerticalContentAlignment="Center" />
                <CheckBox x:Name="LibraryShowPlaylistMpgBox"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          Content="{x:Static domain:UiStrings.LabelLibraryShowPlaylistMpg}"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,6"
                          VerticalContentAlignment="Center" />
              </StackPanel>

              <TextBlock x:Name="LibraryColumnsHeader"
                         Grid.Row="1"
                         Text="{x:Static domain:UiStrings.LabelLibraryListColumns}"
                         FontWeight="Bold"
                         FontSize="11.333"
                         Margin="0,0,0,8"
                         TextWrapping="Wrap" />

              <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="100" />
                    <ColumnDefinition Width="{x:Static ui:DesignMetrics.SettingsColumnGapGrid}" />
                    <ColumnDefinition Width="*" MinWidth="100" />
                    <ColumnDefinition Width="{x:Static ui:DesignMetrics.SettingsColumnGapGrid}" />
                    <ColumnDefinition Width="*" MinWidth="100" />
                  </Grid.ColumnDefinitions>

                  <ScrollViewer Style="{StaticResource SettingsColumnScrollViewerStyle}">
                    <StackPanel>
                      <TextBlock x:Name="LibraryColumnsVideoHeader"
                                 Text="{x:Static domain:UiStrings.LabelLibraryListColumnsVideo}"
                                 FontWeight="Bold"
                                 FontSize="11.333"
                                 Margin="0,0,0,8"
                                 TextWrapping="Wrap" />
                      <StackPanel x:Name="LibraryColumnsVideoHost" />
                      <ui:RoundedButton x:Name="LibraryColumnsVideoResetButton"
                                        Content="{x:Static domain:UiStrings.LabelLibraryListColumnsReset}"
                                        Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                                        MinWidth="88"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Padding="12,0"
                                        Click="LibraryColumnsVideoResetButton_Click" />
                    </StackPanel>
                  </ScrollViewer>

                  <ScrollViewer Grid.Column="2"
                                Style="{StaticResource SettingsColumnScrollViewerStyle}">
                    <StackPanel>
                      <TextBlock x:Name="LibraryColumnsWaveHeader"
                                 Text="{x:Static domain:UiStrings.LabelLibraryListColumnsWave}"
                                 FontWeight="Bold"
                                 FontSize="11.333"
                                 Margin="0,0,0,8"
                                 TextWrapping="Wrap" />
                      <StackPanel x:Name="LibraryColumnsWaveHost" />
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LibraryPlaylistWaveformSizeWaveHeader"
                                   Text="{x:Static domain:UiStrings.LabelLibraryPlaylistWaveformSize}"
                                   FontWeight="Bold"
                                   FontSize="11.333"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   TextWrapping="Wrap" />
                        <ComboBox x:Name="LibraryPlaylistWaveformSizeWaveCombo"
                                  Grid.Column="1"
                                  Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                  HorizontalAlignment="Left"
                                  MinWidth="72"
                                  VerticalAlignment="Center" />
                      </Grid>
                      <ui:RoundedButton x:Name="LibraryColumnsWaveResetButton"
                                        Content="{x:Static domain:UiStrings.LabelLibraryListColumnsReset}"
                                        Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                                        MinWidth="88"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Padding="12,0"
                                        Click="LibraryColumnsWaveResetButton_Click" />
                    </StackPanel>
                  </ScrollViewer>

                  <ScrollViewer Grid.Column="4"
                                Style="{StaticResource SettingsColumnScrollViewerStyle}">
                    <StackPanel>
                      <TextBlock x:Name="LibraryColumnsMp3Header"
                                 Text="{x:Static domain:UiStrings.LabelLibraryListColumnsMp3}"
                                 FontWeight="Bold"
                                 FontSize="11.333"
                                 Margin="0,0,0,8"
                                 TextWrapping="Wrap" />
                      <StackPanel x:Name="LibraryColumnsMp3Host" />
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LibraryPlaylistWaveformSizeMp3Header"
                                   Text="{x:Static domain:UiStrings.LabelLibraryPlaylistWaveformSize}"
                                   FontWeight="Bold"
                                   FontSize="11.333"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   TextWrapping="Wrap" />
                        <ComboBox x:Name="LibraryPlaylistWaveformSizeMp3Combo"
                                  Grid.Column="1"
                                  Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                  HorizontalAlignment="Left"
                                  MinWidth="72"
                                  VerticalAlignment="Center" />
                      </Grid>
                      <ui:RoundedButton x:Name="LibraryColumnsMp3ResetButton"
                                        Content="{x:Static domain:UiStrings.LabelLibraryListColumnsReset}"
                                        Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                                        MinWidth="88"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Padding="12,0"
                                        Click="LibraryColumnsMp3ResetButton_Click" />
                    </StackPanel>
                  </ScrollViewer>
              </Grid>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem x:Name="ColorTab" Header="{x:Static domain:UiStrings.LabelSettingsTabColor}">
          <Grid MaxWidth="{x:Static ui:DesignMetrics.SettingsPanelWidth}"
                HorizontalAlignment="Left">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="{x:Static domain:UiStrings.LabelUiColorSettings}"
                         FontWeight="Bold"
                         FontSize="11.333"
                         Margin="0,0,0,6" />
              <TextBlock Text="{x:Static domain:UiStrings.HintUiColorSettings}"
                         FontSize="11.333"
                         Foreground="{DynamicResource MutedForeBrush}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8" />
              <ui:RoundedButton x:Name="OpenColorSettingsButton"
                                Content="{x:Static domain:UiStrings.ButtonOpenColorSettings}"
                                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                MinWidth="72"
                                Padding="12,0"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,20"
                                Click="OpenColorSettingsButton_Click" />

              <TextBlock Text="{x:Static domain:UiStrings.LabelFileNameColorMarkers}"
                         FontWeight="Bold"
                         FontSize="11.333"
                         Margin="0,0,0,6" />
              <TextBlock Text="{x:Static domain:UiStrings.HintFileNameColorMarkers}"
                         FontSize="11.333"
                         Foreground="{DynamicResource MutedForeBrush}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8" />
            </StackPanel>
            <ScrollViewer Grid.Row="1"
                          Style="{StaticResource SettingsColumnScrollViewerStyle}">
              <StackPanel x:Name="FileNameColorMarkerHost">
                <ui:RoundedButton x:Name="FileNameColorMarkerAddButton"
                                  Content="{x:Static domain:UiStrings.ButtonFileNameColorMarkerAdd}"
                                  Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                  MinWidth="72"
                                  Padding="12,0"
                                  HorizontalAlignment="Left" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <TabItem x:Name="AudioTab" Header="{x:Static domain:UiStrings.LabelSettingsTabAudio}">
          <Grid x:Name="AudioTabBody">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
              <TextBlock x:Name="DefaultFormatHeader"
                         Text="{x:Static domain:UiStrings.LabelDefaultAudioFormat}"
                         FontWeight="Bold"
                         FontSize="11.333"
                         Margin="0,0,0,6" />
              <Grid HorizontalAlignment="Left" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DefaultSampleRateLabel"
                           Text="{x:Static domain:UiStrings.LabelDefaultSampleRate}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox x:Name="DefaultSampleRateCombo"
                          Grid.Column="1"
                          HorizontalAlignment="Left"
                          Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                          Padding="6,1"
                          FontSize="11.333"
                          VerticalContentAlignment="Center" />
                <TextBlock x:Name="DefaultBitDepthLabel"
                           Grid.Column="2"
                           Text="{x:Static domain:UiStrings.LabelDefaultBitDepth}"
                           VerticalAlignment="Center"
                           Margin="16,0,8,0" />
                <ComboBox x:Name="DefaultBitDepthCombo"
                          Grid.Column="3"
                          HorizontalAlignment="Left"
                          Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                          Padding="6,1"
                          FontSize="11.333"
                          VerticalContentAlignment="Center" />
                <TextBlock x:Name="DefaultChannelLayoutLabel"
                           Grid.Column="4"
                           Text="{x:Static domain:UiStrings.LabelDefaultChannelLayout}"
                           VerticalAlignment="Center"
                           Margin="16,0,8,0" />
                <ComboBox x:Name="DefaultChannelLayoutCombo"
                          Grid.Column="5"
                          HorizontalAlignment="Left"
                          Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                          Padding="6,1"
                          FontSize="11.333"
                          VerticalContentAlignment="Center" />
              </Grid>

              <CheckBox x:Name="AutoSpeakerSelectBox"
                        Style="{StaticResource DarkCheckBoxStyle}"
                        Content="{x:Static domain:UiStrings.LabelAutoSpeakerSelect}"
                        Margin="0,0,0,14"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center" />

              <TextBlock x:Name="MonitorHeader"
                         Text="{x:Static domain:UiStrings.LabelMonitor}"
                         FontWeight="Bold"
                         FontSize="11.333"
                         Margin="0,0,0,6" />
              <Grid HorizontalAlignment="Left" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MonitorDimLabel"
                           Text="{x:Static domain:UiStrings.LabelMonitorDimAmount}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox x:Name="MonitorDimBox"
                         Grid.Column="1"
                         Width="{x:Static ui:DesignMetrics.SettingsLoudnessBoxWidth}"
                         Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Padding="6,1"
                         FontSize="11.333"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         InputMethod.IsInputMethodEnabled="False" />
                <TextBlock x:Name="MonitorDimUnit"
                           Grid.Column="2"
                           Text="{x:Static domain:UiStrings.LabelDb}"
                           VerticalAlignment="Center"
                           Margin="8,0,16,0" />
                <TextBlock x:Name="MonitorLowCutLabel"
                           Grid.Column="3"
                           Text="{x:Static domain:UiStrings.LabelMonitorLowCutCutoff}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox x:Name="MonitorLowCutBox"
                         Grid.Column="4"
                         Width="{x:Static ui:DesignMetrics.SettingsLoudnessBoxWidth}"
                         Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Padding="6,1"
                         FontSize="11.333"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         InputMethod.IsInputMethodEnabled="False" />
                <TextBlock x:Name="MonitorLowCutUnit"
                           Grid.Column="5"
                           Text="{x:Static domain:UiStrings.LabelHertz}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
              </Grid>

              <TextBlock x:Name="SpeakerIoHeader"
                         Text="{x:Static domain:UiStrings.LabelSpeakerIo}"
                         FontWeight="Bold"
                         FontSize="11.333"
                         Margin="0,0,0,6" />
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SpeakerLabel"
                           Text="{x:Static domain:UiStrings.LabelSpeaker}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox x:Name="SpeakerCombo"
                          Grid.Column="1"
                          HorizontalAlignment="Left"
                          Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                          Padding="6,1"
                          FontSize="11.333"
                          VerticalContentAlignment="Center"
                          SelectionChanged="SpeakerCombo_SelectionChanged" />
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ApiLabel"
                           Text="{x:Static domain:UiStrings.LabelAudioApi}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox x:Name="ApiCombo"
                          Grid.Column="1"
                          HorizontalAlignment="Left"
                          Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                          Padding="6,1"
                          FontSize="11.333"
                          VerticalContentAlignment="Center"
                          SelectionChanged="ApiCombo_SelectionChanged" />
                <TextBlock x:Name="DeviceLabel"
                           Grid.Column="2"
                           Text="{x:Static domain:UiStrings.LabelAudioDevice}"
                           VerticalAlignment="Center"
                           Margin="16,0,8,0" />
                <ComboBox x:Name="DeviceCombo"
                          Grid.Column="3"
                          HorizontalAlignment="Left"
                          Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                          Padding="6,1"
                          FontSize="11.333"
                          VerticalContentAlignment="Center"
                          SelectionChanged="DeviceCombo_SelectionChanged" />
              </Grid>
            </StackPanel>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{x:Static ui:DesignMetrics.SettingsColumnGapGrid}" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ScrollViewer Style="{StaticResource SettingsColumnScrollViewerStyle}">
                <StackPanel>
                  <TextBlock x:Name="InputHeader"
                             Text="{x:Static domain:UiStrings.LabelSettingsInput}"
                             FontWeight="Bold"
                             FontSize="11.333"
                             Margin="0,0,0,6" />

                  <StackPanel x:Name="RecordInputHost" Margin="0,0,0,6" />
                  <TextBlock x:Name="InputStatus"
                             FontSize="11"
                             Foreground="{DynamicResource MutedForeBrush}"
                             TextWrapping="Wrap"
                             Visibility="Collapsed" />
                </StackPanel>
              </ScrollViewer>

              <ScrollViewer Grid.Column="2"
                            Style="{StaticResource SettingsColumnScrollViewerStyle}">
                <StackPanel>
                  <TextBlock x:Name="OutputHeader"
                             Text="{x:Static domain:UiStrings.LabelSettingsOutput}"
                             FontWeight="Bold"
                             FontSize="11.333"
                             Margin="0,0,0,6" />

                  <StackPanel x:Name="PlaybackOutputHost" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem x:Name="PlayerTab" Header="{x:Static domain:UiStrings.LabelSettingsTabPlayer}">
          <!-- ルート一覧はウィンドウ左右パッド内いっぱい。マージンは外枠 AudioPad と同じ。 -->
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="220" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox x:Name="GaplessPlaybackBox"
                      Style="{StaticResource DarkCheckBoxStyle}"
                      Content="{x:Static domain:UiStrings.LabelGaplessPlayback}"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,16" />
            <TextBlock x:Name="LibraryExplorerRootsHeader"
                       Grid.Row="1"
                       Text="{x:Static domain:UiStrings.LabelLibraryExplorerRoots}"
                       FontWeight="Bold"
                       FontSize="11.333"
                       Margin="0,0,0,4"
                       HorizontalAlignment="Left" />
            <ListBox x:Name="LibraryExplorerRootsList"
                     Grid.Row="2"
                     FontSize="11"
                     Padding="2"
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False"
                     SelectionMode="Extended"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="LibraryExplorerRootsList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="LibraryExplorerRootsList_PreviewMouseMove"
                     DragOver="LibraryExplorerRootsList_DragOver"
                     Drop="LibraryExplorerRootsList_Drop"
                     SelectionChanged="LibraryExplorerRootsList_SelectionChanged" />
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Left">
              <ui:RoundedButton x:Name="LibraryExplorerRootAddButton"
                                Content="{x:Static domain:UiStrings.ButtonLibraryExplorerRootAdd}"
                                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                MinWidth="72"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                Click="LibraryExplorerRootAddButton_Click" />
              <ui:RoundedButton x:Name="LibraryExplorerRootRemoveButton"
                                Content="{x:Static domain:UiStrings.ButtonLibraryExplorerRootRemove}"
                                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                MinWidth="72"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                Click="LibraryExplorerRootRemoveButton_Click" />
              <ui:RoundedButton x:Name="LibraryExplorerRootUpButton"
                                Content="{x:Static domain:UiStrings.ButtonLibraryExplorerRootUp}"
                                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                MinWidth="72"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                Click="LibraryExplorerRootUpButton_Click" />
              <ui:RoundedButton x:Name="LibraryExplorerRootDownButton"
                                Content="{x:Static domain:UiStrings.ButtonLibraryExplorerRootDown}"
                                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                MinWidth="72"
                                Padding="12,0"
                                Click="LibraryExplorerRootDownButton_Click" />
            </StackPanel>
            <StackPanel Grid.Row="4" Margin="0,16,0,0" HorizontalAlignment="Left">
              <TextBlock x:Name="LibraryCatalogHeader"
                         Text="{x:Static domain:UiStrings.LabelLibraryCatalog}"
                         FontWeight="Bold"
                         FontSize="11.333"
                         Margin="0,0,0,6" />
              <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LibraryCatalogUsageText"
                           FontSize="11.333"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ui:RoundedButton x:Name="LibraryCatalogClearButton"
                                  Grid.Column="1"
                                  Content="{x:Static domain:UiStrings.ButtonLibraryCatalogClear}"
                                  Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                  MinWidth="96"
                                  Padding="12,0"
                                  Click="LibraryCatalogClearButton_Click" />
              </Grid>
            </StackPanel>
          </Grid>
        </TabItem>

        <TabItem x:Name="EditingTab" Header="{x:Static domain:UiStrings.LabelSettingsTabEditing}">
          <StackPanel MaxWidth="{x:Static ui:DesignMetrics.SettingsPanelWidth}"
                      HorizontalAlignment="Left">
            <TextBlock x:Name="LoudnessTargetLabel"
                       Text="{x:Static domain:UiStrings.LabelLoudnessTarget}"
                       Margin="0,0,0,3" />
            <Grid HorizontalAlignment="Left" Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="LoudnessTargetBox"
                       Width="{x:Static ui:DesignMetrics.SettingsLoudnessBoxWidth}"
                       Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                       Style="{StaticResource DarkTextBoxStyle}"
                       Padding="6,1"
                       FontSize="11.333"
                       TextAlignment="Center"
                       VerticalContentAlignment="Center"
                       InputMethod.IsInputMethodEnabled="False" />
              <TextBlock x:Name="LoudnessTargetUnit"
                         Grid.Column="1"
                         Text="{x:Static domain:UiStrings.LabelLufs}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0" />
            </Grid>

            <TextBlock x:Name="SilentSkipThresholdLabel"
                       Text="{x:Static domain:UiStrings.LabelSilentSkipThreshold}"
                       Margin="0,0,0,3" />
            <Grid HorizontalAlignment="Left" Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="SilentSkipThresholdBox"
                       Width="{x:Static ui:DesignMetrics.SettingsLoudnessBoxWidth}"
                       Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                       Style="{StaticResource DarkTextBoxStyle}"
                       Padding="6,1"
                       FontSize="11.333"
                       TextAlignment="Center"
                       VerticalContentAlignment="Center"
                       InputMethod.IsInputMethodEnabled="False" />
              <TextBlock x:Name="SilentSkipThresholdUnit"
                         Grid.Column="1"
                         Text="{x:Static domain:UiStrings.LabelDb}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0" />
              <ui:ChannelLevelBar x:Name="SilentSkipThresholdMeter"
                                  Grid.Column="2"
                                  Channel="0"
                                  Channels="1"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center" />
              <StackPanel Grid.Column="3"
                          Orientation="Horizontal"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0">
                <TextBlock x:Name="SilentSkipThresholdFloorText"
                           FontFamily="Consolas"
                           FontSize="11.333" />
                <TextBlock x:Name="SilentSkipThresholdFloorNote"
                           Text="{x:Static domain:UiStrings.LabelSilentSkipFloorNote}"
                           Foreground="{DynamicResource MutedForeBrush}"
                           FontSize="11.333"
                           Margin="4,0,0,0" />
              </StackPanel>
            </Grid>

            <TextBlock x:Name="SilentSkipRecordPadLabel"
                       Text="{x:Static domain:UiStrings.LabelSilentSkipRecordPad}"
                       Margin="0,0,0,3" />
            <Grid HorizontalAlignment="Left" Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="SilentSkipRecordPadBox"
                       Width="{x:Static ui:DesignMetrics.SettingsLoudnessBoxWidth}"
                       Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                       Style="{StaticResource DarkTextBoxStyle}"
                       Padding="6,1"
                       FontSize="11.333"
                       TextAlignment="Center"
                       VerticalContentAlignment="Center"
                       InputMethod.IsInputMethodEnabled="False" />
              <TextBlock x:Name="SilentSkipRecordPadUnit"
                         Grid.Column="1"
                         Text="{x:Static domain:UiStrings.LabelMs}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0" />
            </Grid>

            <TextBlock x:Name="ClickGuardFadeLabel"
                       Text="{x:Static domain:UiStrings.LabelClickGuardFade}"
                       Margin="0,0,0,3" />
            <Grid HorizontalAlignment="Left" Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ClickGuardFadeBox"
                       Width="{x:Static ui:DesignMetrics.SettingsLoudnessBoxWidth}"
                       Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                       Style="{StaticResource DarkTextBoxStyle}"
                       Padding="6,1"
                       FontSize="11.333"
                       TextAlignment="Center"
                       VerticalContentAlignment="Center"
                       InputMethod.IsInputMethodEnabled="False" />
              <TextBlock x:Name="ClickGuardFadeUnit"
                         Grid.Column="1"
                         Text="{x:Static domain:UiStrings.LabelMs}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0" />
            </Grid>

            <TextBlock x:Name="FadeDefaultsHeader"
                       Text="{x:Static domain:UiStrings.LabelFadeCurveDefaults}"
                       FontWeight="Bold"
                       FontSize="11.333"
                       Margin="0,4,0,6" />
            <Grid x:Name="FadeRowsHost" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
            </Grid>
          </StackPanel>
        </TabItem>

        <TabItem Header="{x:Static domain:UiStrings.LabelSettingsTabExport}">
          <StackPanel MaxWidth="{x:Static ui:DesignMetrics.SettingsPanelWidth}"
                      HorizontalAlignment="Left">
            <TextBlock x:Name="ExportAudioHeader"
                       Text="{x:Static domain:UiStrings.LabelSettingsExportAudio}"
                       FontWeight="Bold"
                       FontSize="11.333"
                       Margin="0,0,0,6" />

            <TextBlock x:Name="LamePathLabel"
                       Text="{x:Static domain:UiStrings.LabelLamePath}"
                       Margin="0,0,0,3" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="LamePathBox"
                       Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                       Style="{StaticResource DarkTextBoxStyle}"
                       Padding="6,1"
                       FontSize="11.333"
                       VerticalContentAlignment="Center" />
              <ui:RoundedButton x:Name="LameBrowseButton"
                                Grid.Column="1"
                                Content="{x:Static domain:UiStrings.ButtonBrowse}"
                                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                MinWidth="64"
                                Margin="8,0,0,0"
                                Click="LameBrowseButton_Click" />
            </Grid>

            <TextBlock x:Name="LameOptionsLabel"
                       Text="{x:Static domain:UiStrings.LabelLameOptions}"
                       Margin="0,0,0,3" />
            <TextBox x:Name="LameOptionsBox"
                     Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Padding="6,1"
                     FontSize="11.333"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12" />

            <Grid HorizontalAlignment="Left" Margin="0,0,0,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="WindowsBitRateLabel"
                         Text="{x:Static domain:UiStrings.LabelWindowsMp3BitRate}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <ComboBox x:Name="WindowsBitRateCombo"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                        Padding="6,1"
                        FontSize="11.333"
                        VerticalContentAlignment="Center" />
            </Grid>

            <TextBlock x:Name="ExportMovieHeader"
                       Text="{x:Static domain:UiStrings.LabelSettingsExportMovie}"
                       FontWeight="Bold"
                       FontSize="11.333"
                       Margin="0,0,0,6" />

            <TextBlock x:Name="FfmpegPathLabel"
                       Text="{x:Static domain:UiStrings.LabelFfmpegPath}"
                       Margin="0,0,0,3" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="FfmpegPathBox"
                       Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                       Style="{StaticResource DarkTextBoxStyle}"
                       Padding="6,1"
                       FontSize="11.333"
                       VerticalContentAlignment="Center"
                       TextChanged="FfmpegPathBox_TextChanged" />
              <ui:RoundedButton x:Name="FfmpegBrowseButton"
                                Grid.Column="1"
                                Content="{x:Static domain:UiStrings.ButtonBrowse}"
                                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                MinWidth="64"
                                Margin="8,0,0,0"
                                Click="FfmpegBrowseButton_Click" />
            </Grid>

            <CheckBox x:Name="VideoProxyDisableAutoEncodeBox"
                      Style="{StaticResource DarkCheckBoxStyle}"
                      Content="{x:Static domain:UiStrings.LabelVideoProxyDisableAutoEncode}"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,12" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="VideoProxyRetentionHeader"
                         Text="{x:Static domain:UiStrings.LabelVideoProxyRetention}"
                         FontSize="11.333"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"
                         TextWrapping="Wrap" />
              <ComboBox x:Name="VideoProxyRetentionCombo"
                        Grid.Column="1"
                        Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                        HorizontalAlignment="Left"
                        MinWidth="72"
                        VerticalAlignment="Center" />
            </Grid>
            <Grid HorizontalAlignment="Left" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="VideoProxyUsageText"
                         FontSize="11.333"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <ui:RoundedButton x:Name="VideoProxyClearAllButton"
                                Grid.Column="1"
                                Content="{x:Static domain:UiStrings.ButtonVideoProxyClearAll}"
                                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                                MinWidth="96"
                                Click="VideoProxyClearAllButton_Click" />
            </Grid>
          </StackPanel>
        </TabItem>

        <TabItem Header="{x:Static domain:UiStrings.LabelSettingsTabWwise}">
          <StackPanel MaxWidth="{x:Static ui:DesignMetrics.SettingsPanelWidth}"
                      HorizontalAlignment="Left">
            <TextBlock x:Name="WwisePrefetchLengthLabel"
                       Text="{x:Static domain:UiStrings.LabelWwisePrefetchLength}"
                       Margin="0,0,0,3" />
            <Grid HorizontalAlignment="Left" Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="WwisePrefetchLengthBox"
                       Width="{x:Static ui:DesignMetrics.SettingsLoudnessBoxWidth}"
                       Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                       Style="{StaticResource DarkTextBoxStyle}"
                       Padding="6,1"
                       FontSize="11.333"
                       TextAlignment="Center"
                       VerticalContentAlignment="Center"
                       InputMethod.IsInputMethodEnabled="False" />
              <TextBlock x:Name="WwisePrefetchLengthUnit"
                         Grid.Column="1"
                         Text="{x:Static domain:UiStrings.LabelMs}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0" />
            </Grid>

            <TextBlock x:Name="WwiseLookAheadTimeLabel"
                       Text="{x:Static domain:UiStrings.LabelWwiseLookAheadTime}"
                       Margin="0,0,0,3" />
            <Grid HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="WwiseLookAheadTimeBox"
                       Width="{x:Static ui:DesignMetrics.SettingsLoudnessBoxWidth}"
                       Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                       Style="{StaticResource DarkTextBoxStyle}"
                       Padding="6,1"
                       FontSize="11.333"
                       TextAlignment="Center"
                       VerticalContentAlignment="Center"
                       InputMethod.IsInputMethodEnabled="False" />
              <TextBlock x:Name="WwiseLookAheadTimeUnit"
                         Grid.Column="1"
                         Text="{x:Static domain:UiStrings.LabelMs}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0" />
            </Grid>
          </StackPanel>
        </TabItem>
      </TabControl>

      <StackPanel Grid.Row="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,16,0,0">
        <ui:RoundedButton x:Name="OkButton"
                          Content="{x:Static domain:UiStrings.ButtonOk}"
                          Width="{x:Static ui:DesignMetrics.AudioDialogButtonWidth}"
                          Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                          Margin="0,0,12,0"
                          IsDefault="True"
                          Click="OkButton_Click" />
        <ui:RoundedButton x:Name="CancelButton"
                          Content="{x:Static domain:UiStrings.ButtonCancel}"
                          Width="{x:Static ui:DesignMetrics.AudioDialogButtonWidth}"
                          Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                          IsCancel="True"
                          Click="CancelButton_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
