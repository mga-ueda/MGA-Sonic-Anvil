<Window x:Class="MgaSonicAnvil.UI.ColorDevPanelWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MgaSonicAnvil.UI"
        xmlns:domain="clr-namespace:MgaSonicAnvil.Domain"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Width="720"
        MinWidth="640"
        MinHeight="420"
        Height="640"
        Background="{DynamicResource ColorPanelBackBrush}"
        Foreground="{DynamicResource PrimaryForeBrush}"
        KeyDown="Window_KeyDown">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="240" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="280" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBox x:Name="SearchBox"
                   Style="{StaticResource DarkTextBoxStyle}"
                   Padding="8,5"
                   TextChanged="SearchBox_TextChanged"
                   GotKeyboardFocus="SearchBox_FocusChanged"
                   LostKeyboardFocus="SearchBox_FocusChanged" />
          <TextBlock x:Name="SearchHint"
                     Text="{x:Static domain:UiStrings.ColorDevSearch}"
                     Foreground="{DynamicResource MutedForeBrush}"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />
        </Grid>
        <Grid>
          <ScrollViewer x:Name="Scroll"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Background="{DynamicResource SurfaceBackBrush}"
                        PreviewKeyDown="Scroll_PreviewKeyDown">
            <StackPanel x:Name="ListPanel" Margin="4" />
          </ScrollViewer>
          <TextBlock x:Name="EmptyHint"
                     Text="{x:Static domain:UiStrings.ColorDevNoMatches}"
                     Foreground="{DynamicResource MutedForeBrush}"
                     Margin="12"
                     TextWrapping="Wrap"
                     Visibility="Collapsed" />
        </Grid>
      </DockPanel>

      <GridSplitter Grid.Column="1"
                    Width="10"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource ColorPanelBackBrush}"
                    Focusable="False" />

      <Border Grid.Column="2"
              Padding="12"
              Background="{DynamicResource SurfaceBackBrush}"
              BorderBrush="{DynamicResource ChromeBorderBrush}"
              BorderThickness="1">
        <DockPanel>
          <TextBlock x:Name="SelectedName"
                     DockPanel.Dock="Top"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Margin="0,0,0,10" />
          <ui:RoundedButton x:Name="ResetThisButton"
                            DockPanel.Dock="Bottom"
                            Content="{x:Static domain:UiStrings.ColorDevResetThis}"
                            Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                            Margin="0,12,0,0"
                            Padding="12,0"
                            Click="ResetThisButton_Click" />
          <TextBlock x:Name="PickerHint"
                     Text="{x:Static domain:UiStrings.ColorDevPickHint}"
                     Foreground="{DynamicResource MutedForeBrush}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Top"
                     Visibility="Collapsed" />
          <ui:HsvColorPicker x:Name="Picker" />
        </DockPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,10,0,0">
      <ui:RoundedButton x:Name="ResetButton"
                        Content="{x:Static domain:UiStrings.ColorDevResetToDefaults}"
                        MinWidth="{x:Static ui:DesignMetrics.AudioDialogButtonWidth}"
                        Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                        Padding="12,0"
                        Margin="0,0,8,0"
                        Click="ResetButton_Click" />
      <ui:RoundedButton x:Name="CloseButton"
                        Content="{x:Static domain:UiStrings.ColorDevClose}"
                        MinWidth="{x:Static ui:DesignMetrics.AudioDialogButtonWidth}"
                        Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                        Padding="12,0"
                        Click="CloseButton_Click" />
    </StackPanel>
  </Grid>
</Window>
