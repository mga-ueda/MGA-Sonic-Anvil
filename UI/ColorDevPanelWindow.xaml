<Window x:Class="MgaSonicAnvil.UI.ColorDevPanelWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:MgaSonicAnvil.Domain"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        SizeToContent="Width"
        MinHeight="320"
        Height="640"
        Background="{DynamicResource ColorPanelBackBrush}"
        Foreground="{DynamicResource PrimaryForeBrush}"
        KeyDown="Window_KeyDown">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer x:Name="Scroll"
                  Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource ColorPanelListBackBrush}">
      <StackPanel x:Name="ListPanel"
                  Margin="4"
                  Grid.IsSharedSizeScope="True" />
    </ScrollViewer>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,8,0,0">
      <Button x:Name="ResetButton"
              Content="{x:Static domain:UiStrings.ColorDevResetToDefaults}"
              Margin="0,0,8,0"
              Click="ResetButton_Click" />
      <Button x:Name="CloseButton"
              Content="{x:Static domain:UiStrings.ColorDevClose}"
              Click="CloseButton_Click" />
    </StackPanel>
  </Grid>
</Window>
