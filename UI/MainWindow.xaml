<Window x:Class="MgaSonicAnvil.UI.MainWindow"
        x:ClassModifier="public"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MgaSonicAnvil.UI"
        xmlns:domain="clr-namespace:MgaSonicAnvil.Domain"
        Title="{x:Static domain:AppVersion.ProductName}"
        MinWidth="{x:Static ui:DesignMetrics.WindowMinWidth}"
        MinHeight="{x:Static ui:DesignMetrics.WindowMinHeight}"
        Width="{x:Static ui:DesignMetrics.WindowDefaultWidth}"
        Height="{x:Static ui:DesignMetrics.WindowDefaultHeight}"
        Opacity="0"
        AllowDrop="True"
        ToolTipService.IsEnabled="False"
        Background="{DynamicResource SurfaceBackBrush}">
  <Grid x:Name="RootChrome">
  <DockPanel x:Name="RootDock" LastChildFill="True">
    <Border DockPanel.Dock="Bottom"
            Height="{x:Static ui:DesignMetrics.StatusBarHeight}"
            Background="{DynamicResource StatusBarBackBrush}"
            Padding="8,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusMeta"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="0,0,8,0"
                   FontFamily="Consolas"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource StatusBarDetailForeBrush}" />
        <ui:StatusTimeStrip x:Name="StatusTimes"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
        <CheckBox x:Name="AlwaysOnTopCheck"
                  Grid.Column="2"
                  Style="{StaticResource DarkCheckBoxStyle}"
                  Content="{x:Static domain:UiStrings.LabelAlwaysOnTop}"
                  VerticalAlignment="Center"
                  FontSize="11"
                  Foreground="{DynamicResource StatusBarTitleForeBrush}"
                  Checked="AlwaysOnTopCheck_Changed"
                  Unchecked="AlwaysOnTopCheck_Changed" />
      </Grid>
    </Border>

    <ui:WaapiStatusBar x:Name="WaapiBar" DockPanel.Dock="Bottom" />

    <Border x:Name="TipsPanel"
            DockPanel.Dock="Bottom"
            Height="{x:Static ui:DesignMetrics.TipsPanelHeight}"
            Visibility="Collapsed"
            Background="{DynamicResource WaapiBarBackBrush}"
            BorderBrush="{DynamicResource ChromeBorderBrush}"
            BorderThickness="1">
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="TipsHeader"
                   DockPanel.Dock="Top"
                   Height="{x:Static ui:DesignMetrics.TipsHeaderHeight}"
                   Padding="8,0"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   FontSize="11"
                   Cursor="Hand"
                   Foreground="{DynamicResource StatusBarTitleForeBrush}"
                   Text="{x:Static domain:UiStrings.LabelTips}"
                   MouseLeftButtonDown="TipsPin_MouseLeftButtonDown" />
        <ScrollViewer x:Name="TipsScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Focusable="False"
                      PanningMode="VerticalOnly">
          <TextBlock x:Name="TipsLabel"
                     Padding="8,4,8,5"
                     FontSize="11"
                     TextWrapping="Wrap"
                     TextTrimming="None"
                     Cursor="Hand"
                     Foreground="{DynamicResource StatusBarDetailForeBrush}"
                     MouseLeftButtonDown="TipsPin_MouseLeftButtonDown" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="{x:Static ui:DesignMetrics.VectorScopeHeightGrid}" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Grid.Column="0">
        <Grid DockPanel.Dock="Top"
              Height="{x:Static ui:DesignMetrics.ProjectBarHeight}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Static ui:DesignMetrics.DbScaleWidthGrid}" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="{DynamicResource TransportBackBrush}">
            <ui:SettingsGearButton x:Name="SettingsGear"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Click="SettingsGearButton_Click" />
          </Border>
          <Border Grid.Column="1"
                  Padding="{x:Static ui:DesignMetrics.OverviewPad}"
                  Background="{DynamicResource ProjectBarBackBrush}">
            <ui:OverviewView x:Name="Overview" />
          </Border>
        </Grid>
        <Border Background="{DynamicResource WaveformScrollTrackBrush}"
                MinHeight="{x:Static ui:DesignMetrics.WaveformHostMinHeight}"
                AllowDrop="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="{x:Static ui:DesignMetrics.WaveformScrollBarHeightGrid}" />
            </Grid.RowDefinitions>
            <ui:WaveformView x:Name="Waveform" Grid.Row="0" />
            <ui:TimeScrollBar x:Name="TimeScroll"
                              Grid.Row="1"
                              Style="{StaticResource DarkScrollBarStyle}"
                              Background="{DynamicResource TimelineWellBackBrush}" />
          </Grid>
        </Border>
      </DockPanel>

      <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
            Width="{x:Static ui:DesignMetrics.LevelMeterWidth}"
            Background="{DynamicResource TransportBackBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="{x:Static ui:DesignMetrics.ProjectBarHeightGrid}" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="MeterTopSlot"
                Grid.Row="0"
                Background="{DynamicResource TransportBackBrush}" />
        <ui:LevelMeterView x:Name="LevelMeter"
                           Grid.Row="1"
                           VerticalAlignment="Stretch" />
        <ui:VectorScopeView x:Name="VectorScope"
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            />
      </Grid>

      <Grid Grid.Row="1" Grid.Column="0"
            Background="{DynamicResource TransportBackBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="DocumentTabHost"
                Grid.Row="0"
                Grid.Column="0"
                Height="{x:Static ui:DesignMetrics.DocumentTabBarHeight}"
                Background="{DynamicResource TransportBackBrush}"
                SizeChanged="DocumentTabHost_SizeChanged">
          <DockPanel>
            <ui:TabScrollButton x:Name="TabScrollLeft"
                                DockPanel.Dock="Left"
                                PointLeft="True"
                                Visibility="Collapsed"
                                Click="TabScrollLeft_Click" />
            <ui:TabScrollButton x:Name="TabScrollRight"
                                DockPanel.Dock="Right"
                                Visibility="Collapsed"
                                Click="TabScrollRight_Click" />
            <ScrollViewer x:Name="DocumentTabScroll"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False"
                          PanningMode="HorizontalOnly"
                          ScrollChanged="DocumentTabScroll_ScrollChanged"
                          PreviewMouseWheel="DocumentTabScroll_PreviewMouseWheel">
              <StackPanel x:Name="DocumentTabs"
                          Orientation="Horizontal" />
            </ScrollViewer>
          </DockPanel>
        </Border>
        <Grid Grid.Row="1"
              Grid.Column="0"
              MinHeight="{x:Static ui:DesignMetrics.TransportBarHeight}"
              Background="{DynamicResource TransportBackBrush}">
          <ui:TransportBar x:Name="Transport"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      Margin="12,0,0,6">
            <TextBlock x:Name="CopyrightText"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ActionCopyrightForeBrush}"
                       Text="{x:Static domain:UiStrings.CopyrightText}" />
            <TextBlock x:Name="GitHubLink"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Cursor="Hand"
                       Foreground="{DynamicResource ActionLinkForeBrush}"
                       Text="{x:Static domain:UiStrings.CopyrightGitHub}"
                       MouseLeftButtonUp="GitHubLink_MouseLeftButtonUp" />
          </StackPanel>
        </Grid>
        <ui:LoudnessMeterView x:Name="LoudnessMeter"
                              Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="1"
                              Margin="0,0,6,0"
                              VerticalAlignment="Stretch" />
        <ui:ProjectSpectrumView x:Name="Spectrum"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="2"
                                Height="{x:Static ui:DesignMetrics.SpectrumHeight}"
                                Margin="0,0,1,0"
                                VerticalAlignment="Top" />
      </Grid>
    </Grid>
  </DockPanel>
    <ui:EditHistoryOverlay x:Name="HistoryOverlay"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           ItemClicked="HistoryOverlay_ItemClicked" />
  </Grid>
</Window>
