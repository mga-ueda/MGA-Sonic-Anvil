<Window x:Class="MgaSonicAnvil.UI.MainWindow"
        x:ClassModifier="public"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MgaSonicAnvil.UI"
        xmlns:domain="clr-namespace:MgaSonicAnvil.Domain"
        Title="{x:Static domain:AppVersion.ProductName}"
        MinWidth="{x:Static ui:DesignMetrics.WindowMinWidth}"
        MinHeight="{x:Static ui:DesignMetrics.WindowMinHeight}"
        Width="{x:Static ui:DesignMetrics.WindowDefaultWidth}"
        Height="{x:Static ui:DesignMetrics.WindowDefaultHeight}"
        Opacity="0"
        AllowDrop="True"
        ToolTipService.IsEnabled="False"
        Background="Transparent">
  <Grid x:Name="RootChrome">
    <Grid x:Name="PlaybackScene">
    <Grid x:Name="PlayerWaveGlowHost"
          IsHitTestVisible="False"
          Visibility="Collapsed"
          ClipToBounds="True" />
    <Grid x:Name="PlayerVisualHost"
          IsHitTestVisible="False"
          ClipToBounds="True" />
  <DockPanel x:Name="RootDock" LastChildFill="True">
    <Menu x:Name="MainMenuBar"
          DockPanel.Dock="Top"
          Style="{StaticResource DarkMenuStyle}" />
    <!-- 旧アナライザ左のトランスポート。既定はメニュー直下。設定でステータスバー上にも置ける。狭幅では折り返して全表示。 -->
    <Border x:Name="TransportToolbarHost"
            DockPanel.Dock="Top"
            Background="{DynamicResource TransportBackBrush}">
      <ui:TransportBar x:Name="Transport"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Top" />
    </Border>
    <Border x:Name="StatusBarHost"
            DockPanel.Dock="Bottom"
            Height="{x:Static ui:DesignMetrics.StatusBarHeight}"
            Background="Transparent">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ProgressBar x:Name="StatusOpenProgress"
                     Grid.ColumnSpan="3"
                     Style="{StaticResource StatusOpenProgressStyle}"
                     VerticalAlignment="Bottom"
                     Minimum="0"
                     Maximum="1"
                     Value="0"
                     Visibility="Collapsed" />
        <TextBlock x:Name="StatusMeta"
                   Margin="8,0,8,0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   FontFamily="Consolas"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource StatusBarDetailForeBrush}" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
          <ui:MonitorLatchButton x:Name="CenterLockLatch"
                                 LatchLabel="{x:Static domain:UiStrings.LabelCenterLock}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"
                                 Click="CenterLockLatch_Click" />
          <ui:MonitorLatchButton x:Name="MarkerClickLatch"
                                 LatchLabel="{x:Static domain:UiStrings.LabelMarkerClick}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"
                                 Click="MarkerClickLatch_Click" />
          <ui:MonitorLatchButton x:Name="SilentSkipLatch"
                                 LatchLabel="{x:Static domain:UiStrings.LabelSilentSkip}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"
                                 Click="SilentSkipLatch_Click" />
          <ui:MonitorLatchButton x:Name="AutoLoopLatch"
                                 LatchLabel="{x:Static domain:UiStrings.LabelLibraryAutoLoop}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"
                                 Click="AutoLoopLatch_Click" />
          <ui:MonitorLatchButton x:Name="AlwaysOnTopLatch"
                                 LatchLabel="{x:Static domain:UiStrings.LabelAlwaysOnTop}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"
                                 Click="AlwaysOnTopLatch_Click" />
          <ui:StatusSpeakerIcon x:Name="SpeakerMenuIcon" />
          <ComboBox x:Name="SpeakerMenu"
                    Style="{StaticResource StatusTimecodeComboStyle}"
                    Height="{x:Static ui:DesignMetrics.StatusTimecodeBoxHeight}"
                    MinWidth="{x:Static ui:DesignMetrics.TransportSpeakerComboWidth}"
                    MaxHeight="{x:Static ui:DesignMetrics.StatusTimecodeBoxHeight}"
                    Padding="6,1,6,1"
                    FontSize="11"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    SelectionChanged="SpeakerMenu_SelectionChanged" />
        </StackPanel>
        <ui:StatusTimeStrip x:Name="StatusTimes"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
      </Grid>
    </Border>

    <ui:WaapiStatusBar x:Name="WaapiBar" DockPanel.Dock="Bottom" />

    <Grid x:Name="WorkGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="MeterColumnDef"
                          Width="{x:Static ui:DesignMetrics.LevelMeterWidthGrid}"
                          MinWidth="{x:Static ui:DesignMetrics.LevelMeterWidth}"
                          MaxWidth="{x:Static ui:DesignMetrics.LevelMeterWidthMax}" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="{x:Static ui:DesignMetrics.TransportChromeHeightGrid}" />
      </Grid.RowDefinitions>

      <DockPanel x:Name="WaveformWorkHost" Grid.Row="0" Grid.Column="0">
        <!-- タブは全体表示（Overview）の上。左は波形開始（dB 目盛り列）に揃える。 -->
        <Border x:Name="DocumentTabHost"
                DockPanel.Dock="Top"
                Height="{x:Static ui:DesignMetrics.DocumentTabBarHeight}"
                Background="Transparent"
                SizeChanged="DocumentTabHost_SizeChanged">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="DocumentTabScaleColumn"
                                Width="{x:Static ui:DesignMetrics.DbScaleWidthGrid}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- ＜ は左スペーサ列。全画面で矢印が出るときは列を広げてタブを右へ。 -->
            <ui:TabScrollButton x:Name="TabScrollLeft"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                PointLeft="True"
                                Visibility="Collapsed"
                                Click="TabScrollLeft_Click" />
            <DockPanel Grid.Column="1">
              <ui:TabScrollButton x:Name="TabScrollRight"
                                  DockPanel.Dock="Right"
                                  Visibility="Collapsed"
                                  Click="TabScrollRight_Click" />
              <ScrollViewer x:Name="DocumentTabScroll"
                            Background="Transparent"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            Focusable="False"
                            PanningMode="HorizontalOnly"
                            ScrollChanged="DocumentTabScroll_ScrollChanged"
                            PreviewMouseWheel="DocumentTabScroll_PreviewMouseWheel">
                <StackPanel x:Name="DocumentTabs"
                            Orientation="Horizontal"
                            ClipToBounds="False" />
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </Border>
        <Grid x:Name="OverviewHost"
              DockPanel.Dock="Top"
              Height="{x:Static ui:DesignMetrics.ProjectBarHeight}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="OverviewScaleColumn"
                              Width="{x:Static ui:DesignMetrics.DbScaleWidthGrid}" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="Transparent" />
          <Border Grid.Column="1"
                  Padding="{x:Static ui:DesignMetrics.OverviewPad}"
                  Background="Transparent">
            <ui:OverviewView x:Name="Overview"
                             MouseRightButtonDown="Overview_MouseRightButtonDown" />
          </Border>
        </Grid>
        <!-- V／P モードの操作バーは波形描画エリア直下（トランスポートより上）。 -->
        <ui:VolumeCurveBar x:Name="VolumeCurveBar" DockPanel.Dock="Bottom" />
        <ui:PitchCurveBar x:Name="PitchCurveBar" DockPanel.Dock="Bottom" />
        <Border x:Name="WaveformHostBorder"
                Background="Transparent"
                MinHeight="{x:Static ui:DesignMetrics.WaveformHostMinHeight}"
                AllowDrop="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition x:Name="LibraryRowDef" Height="0" MinHeight="0" />
              <RowDefinition Height="Auto" />
              <RowDefinition x:Name="LibraryWaveformRowDef" Height="*" />
            </Grid.RowDefinitions>
            <ui:LibraryBrowserView x:Name="LibraryBrowser"
                                   Panel.ZIndex="1"
                                   Visibility="Collapsed" />
            <GridSplitter x:Name="LibrarySplitter"
                          Grid.Row="1"
                          Height="{x:Static ui:DesignMetrics.MeterColumnSplitterWidth}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeBehavior="PreviousAndCurrent"
                          ResizeDirection="Rows"
                          Background="{DynamicResource ChromeBorderBrush}"
                          Cursor="SizeNS"
                          Visibility="Collapsed" />
            <Grid Grid.Row="2"
                  Panel.ZIndex="2"
                  ClipToBounds="True">
            <DockPanel x:Name="LibraryWaveformDock" ClipToBounds="True">
              <ui:WaveformScrollStrip x:Name="TimeScrollStrip"
                                      DockPanel.Dock="Bottom"
                                      Panel.ZIndex="1"
                                      Opacity="0"
                                      IsHitTestVisible="False" />
              <Grid x:Name="WaveformTileHost"
                    Background="Transparent"
                    SizeChanged="WaveformTileHost_SizeChanged">
                <Grid x:Name="SingleWaveformHost">
                  <ui:WaveformView x:Name="PrimaryWaveform" ClipToBounds="True" />
                  <ui:VolumeCurveEditLayer x:Name="VolumeCurveEditLayer" ClipToBounds="True" />
                  <ui:PitchCurveEditLayer x:Name="PitchCurveEditLayer" ClipToBounds="True" />
                </Grid>
              </Grid>
            </DockPanel>
            <Border x:Name="TileSearchHost"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="14,10"
                    CornerRadius="{ui:ControlCorner}"
                    Panel.ZIndex="20"
                    Visibility="Collapsed"
                    Background="{DynamicResource TransportBackBrush}"
                    BorderBrush="{DynamicResource ChromeBorderBrush}"
                    BorderThickness="1">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="TileSearchLabel"
                             VerticalAlignment="Center"
                             FontSize="11"
                             Margin="0,0,8,0"
                             Foreground="{DynamicResource MutedForeBrush}" />
                  <TextBox x:Name="TileSearchBox"
                           Width="260"
                           FontSize="12"
                           FontFamily="Consolas"
                           Padding="2,1"
                           VerticalContentAlignment="Center"
                           Style="{DynamicResource DarkTextBoxStyle}"
                           Foreground="{DynamicResource PrimaryForeBrush}"
                           Background="{DynamicResource DialogInputBackBrush}"
                           BorderBrush="{DynamicResource AccentCyanBrush}"
                           CaretBrush="{DynamicResource PrimaryForeBrush}"
                           TextChanged="TileSearchBox_TextChanged" />
                </StackPanel>
                <TextBlock x:Name="TileSearchHint"
                           FontSize="10.5"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           MaxWidth="348"
                           Foreground="{DynamicResource MutedForeBrush}" />
              </StackPanel>
            </Border>
            </Grid>
          </Grid>
        </Border>
      </DockPanel>

      <GridSplitter x:Name="MeterColumnSplitter"
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.RowSpan="2"
                    Width="{x:Static ui:DesignMetrics.MeterColumnSplitterWidth}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndCurrent"
                    ResizeDirection="Columns"
                    Background="Transparent"
                    Cursor="SizeWE"
                    Panel.ZIndex="8"
                    DragCompleted="MeterColumnSplitter_DragCompleted" />
      <Grid x:Name="MeterColumn"
            Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
            Background="Transparent">
        <!-- ゴニオはアナライザ扱い（表示は ShowAnalyzerArea）。上下ドックでピークの上／下へ。 -->
        <DockPanel x:Name="MeterColumnStack" LastChildFill="True">
          <ui:VectorScopeView x:Name="VectorScope"
                              DockPanel.Dock="Bottom"
                              HorizontalAlignment="Center"
                              Opacity="0"
                              IsHitTestVisible="False" />
          <DockPanel x:Name="MeterPeakHost"
                     LastChildFill="True">
            <Border x:Name="MeterTopSlot"
                    DockPanel.Dock="Top"
                    Height="{x:Static ui:DesignMetrics.ProjectBarHeight}"
                    Margin="{x:Static ui:DesignMetrics.WaapiToPeakLampGapMargin}"
                    Background="Transparent" />
            <ui:LevelMeterView x:Name="LevelMeter"
                               VerticalAlignment="Stretch"
                               Opacity="0"
                               IsHitTestVisible="False" />
          </DockPanel>
        </DockPanel>
      </Grid>

      <Grid x:Name="TransportChromeHost"
            Grid.Row="1" Grid.Column="0"
            Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- エディタ: 左空き幅の 75% を中央に現在位置タイムコード。プレイヤーでラウドネス表示中は波形をここにドック。 -->
        <Grid x:Name="EditorPositionSlot"
              Grid.Column="0"
              Margin="0,0,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border x:Name="PlayerWaveformSlot"
                  Grid.ColumnSpan="3"
                  Background="Transparent"
                  Visibility="Collapsed"
                  ClipToBounds="True" />
          <Viewbox x:Name="EditorPositionTimecodeHost"
                   Grid.Column="1"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Margin="0,4"
                   Opacity="0"
                   Visibility="Collapsed"
                   IsHitTestVisible="False">
            <ui:EditorPositionTimecodeView x:Name="EditorPositionTimecode" />
          </Viewbox>
        </Grid>
        <ui:HistoryStripView x:Name="HistoryStrip"
                             Grid.Column="1"
                             Margin="0,0,6,0"
                             VerticalAlignment="Stretch"
                             Opacity="0"
                             Visibility="Collapsed"
                             IsHitTestVisible="False"
                             OpenRequested="HistoryStrip_OpenRequested" />
        <!-- エディタ限定 VST インサート。ラウドネス情報エリアの左。 -->
        <ui:VstInsertRackView x:Name="VstInsertRack"
                              Grid.Column="2"
                              Margin="0,0,6,0"
                              VerticalAlignment="Stretch"
                              Opacity="0"
                              Visibility="Collapsed"
                              IsHitTestVisible="False" />
        <ui:LoudnessMeterView x:Name="LoudnessMeter"
                              Grid.Column="3"
                              Margin="0,0,6,0"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              Opacity="0"
                              IsHitTestVisible="False" />
        <ui:MonitorToggleColumn x:Name="MonitorToggles"
                                Grid.Column="4"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Opacity="0"
                                IsHitTestVisible="False" />
        <ui:ProjectSpectrumView x:Name="Spectrum"
                                Grid.Column="5"
                                Height="{x:Static ui:DesignMetrics.SpectrumHeight}"
                                Margin="0,0,1,0"
                                Opacity="0"
                                IsHitTestVisible="False"
                                VerticalAlignment="Top" />
      </Grid>
    </Grid>
  </DockPanel>
    </Grid>
    <ui:EditHistoryOverlay x:Name="HistoryOverlay"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           CloseRequested="HistoryOverlay_CloseRequested"
                           ItemClicked="HistoryOverlay_ItemClicked" />
    <!-- A でアナライザを隠しているときだけ。T は無関係。波形は描かず、ファイル名より上。 -->
    <ui:PlaylistVideoSeekBar x:Name="PlaylistVideoSimpleSeek"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Bottom"
                             Height="{x:Static ui:DesignMetrics.PlaylistVideoSimpleSeekHitHeight}"
                             Opacity="0"
                             IsHitTestVisible="False"
                             RatioSeeked="PlaylistVideoSimpleSeek_RatioSeeked" />
    <!-- 影は下層の文字シルエットだけ。要素 Effect だと帯状のラベル影になる。配置は波形帯の上へ。 -->
    <Grid x:Name="PlaylistVideoFileName"
          HorizontalAlignment="Center"
          VerticalAlignment="Bottom"
          Margin="{x:Static ui:DesignMetrics.PlaylistVideoFileNameMargin}"
          MaxWidth="{x:Static ui:DesignMetrics.PlaylistVideoFileNameMaxWidth}"
          Height="{x:Static ui:DesignMetrics.PlaylistVideoFileNameLineHeight}"
          Opacity="0"
          IsHitTestVisible="False">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border x:Name="PlaylistVideoFileNameMarker"
              Width="{x:Static ui:FileNameColorMarkerVisual.Width}"
              Height="{x:Static ui:FileNameColorMarkerVisual.Height}"
              CornerRadius="{x:Static ui:FileNameColorMarkerVisual.Corner}"
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              SnapsToDevicePixels="True"
              Visibility="Collapsed" />
      <TextBlock x:Name="PlaylistVideoFileNameShadow"
                 Grid.Column="1"
                 Height="{x:Static ui:DesignMetrics.PlaylistVideoFileNameLineHeight}"
                 FontSize="{x:Static ui:DesignMetrics.PlaylistVideoFileNameFontSize}"
                 FontWeight="Normal"
                 TextAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 TextWrapping="NoWrap"
                 Foreground="#FF000000" />
      <TextBlock x:Name="PlaylistVideoFileNameText"
                 Grid.Column="1"
                 Height="{x:Static ui:DesignMetrics.PlaylistVideoFileNameLineHeight}"
                 FontSize="{x:Static ui:DesignMetrics.PlaylistVideoFileNameFontSize}"
                 FontWeight="Normal"
                 TextAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 TextWrapping="NoWrap"
                 Foreground="#F5F5F5" />
    </Grid>
    <!-- タイムコード／トースト系すりガラスは AcrylicGlassPopup／AcrylicToastHost（メニューと同じ DWM Acrylic）。 -->
  </Grid>
</Window>
