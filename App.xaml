<Application x:Class="MgaSonicAnvil.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="UI/MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/UiColors.xaml"/>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="AppFontFamily">Yu Gothic UI</FontFamily>
      <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBackBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
      </Style>
      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      </Style>
      <Style TargetType="Control">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      </Style>
      <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}"/>
      <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}"/>
      <Style TargetType="ToolTip" BasedOn="{StaticResource DarkToolTipStyle}"/>
      <Style TargetType="ContextMenu" BasedOn="{StaticResource DarkContextMenuStyle}"/>
      <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItemStyle}"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
